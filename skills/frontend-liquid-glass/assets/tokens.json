{
  "$comment": "platform-independent tokens; CSS px == iOS pt == Android dp; mini-program rpx = px*2",
  "name": "frontend-liquid-glass",
  "version": "1.0.0",
  "unit": "px",
  "presets": {
    "thin": {
      "blur": 12,
      "saturate": 130,
      "brightness": 108,
      "tint": {
        "light": "#FFFFFF",
        "dark": "#0B0E14",
        "alpha": 0.28
      },
      "border": {
        "width": 1,
        "alpha": 0.34
      },
      "highlight": 0.55,
      "shadow": {
        "near": "0 1px 2px rgba(0,0,0,.10)",
        "far": "0 8px 28px rgba(0,0,0,.16)"
      },
      "refraction": 0.4,
      "noise": 0.035,
      "contentAlpha": 0.62
    },
    "standard": {
      "blur": 24,
      "saturate": 160,
      "brightness": 112,
      "tint": {
        "light": "#FFFFFF",
        "dark": "#0C1017",
        "alpha": 0.42
      },
      "border": {
        "width": 1,
        "alpha": 0.4
      },
      "highlight": 0.7,
      "shadow": {
        "near": "0 1px 3px rgba(0,0,0,.12)",
        "far": "0 14px 44px rgba(0,0,0,.22)"
      },
      "refraction": 0.6,
      "noise": 0.045,
      "contentAlpha": 0.78
    },
    "deep": {
      "blur": 40,
      "saturate": 180,
      "brightness": 116,
      "tint": {
        "light": "#F7F8FA",
        "dark": "#080A10",
        "alpha": 0.55
      },
      "border": {
        "width": 1,
        "alpha": 0.46
      },
      "highlight": 0.85,
      "shadow": {
        "near": "0 2px 6px rgba(0,0,0,.16)",
        "far": "0 28px 90px rgba(0,0,0,.34)"
      },
      "refraction": 0.8,
      "noise": 0.055,
      "contentAlpha": 0.9
    },
    "frost": {
      "blur": 8,
      "saturate": 100,
      "brightness": 104,
      "tint": {
        "light": "#FFFFFF",
        "dark": "#0A0D12",
        "alpha": 0.72
      },
      "border": {
        "width": 1,
        "alpha": 0.28
      },
      "highlight": 0.4,
      "shadow": {
        "near": "0 1px 2px rgba(0,0,0,.08)",
        "far": "0 6px 20px rgba(0,0,0,.12)"
      },
      "refraction": 0.25,
      "noise": 0.03,
      "contentAlpha": 0.98
    }
  },
  "stack": {
    "maxLayers": 3,
    "blurFactor": [
      1,
      0.5,
      0.25
    ],
    "alphaBonus": [
      0,
      0.12,
      0.22
    ]
  },
  "motion": {
    "enterMs": 240,
    "exitMs": 160,
    "easeEnter": "cubic-bezier(0.16,1,0.3,1)",
    "easeExit": "cubic-bezier(0.7,0,0.2,1)"
  },
  "contrast": {
    "bodyMin": 4.5,
    "largeTextMin": 3,
    "uiComponentMin": 3
  }
}
