{
  "$comment": "frontend-apple-minimal 的唯一数值真源。改这里就必须同步改 SKILL.md 第三节、references/10-type-grid.md 与 assets/apple-minimal.css。",
  "version": "1.0.0",
  "meta": {
    "name": "frontend-apple-minimal",
    "unit": "px 除注明外",
    "grid": 8
  },
  "grid": {
    "u": {
      "value": 8,
      "note": "所有间距必须是它的倍数，出现 37/55 这类值即退回"
    },
    "gap": {
      "gap-1": {
        "value": 8,
        "use": "图标与文字、标签与值"
      },
      "gap-2": {
        "value": 16,
        "use": "段落内、表单行间"
      },
      "gap-3": {
        "value": 24,
        "use": "卡片内边距"
      },
      "gap-4": {
        "value": 32,
        "use": "标题与正文之间"
      }
    },
    "section": {
      "section-xs": {
        "value": 64,
        "use": "同主题两段之间；下限，再小两节会读成同一组"
      },
      "section-s": {
        "value": 96,
        "use": "常规 section 之间"
      },
      "section-m": {
        "value": 128,
        "use": "主题切换"
      },
      "section-l": {
        "value": 160,
        "use": "展示级分隔：hero 之后、CTA 之前"
      }
    },
    "container": {
      "container": {
        "value": 1120,
        "use": "内容区最大宽度"
      },
      "container-wide": {
        "value": 1440,
        "use": "全幅图文，图出血到边"
      },
      "gutter": {
        "value": "min(6vw, 96px)",
        "use": "页面左右留白"
      },
      "measure": {
        "value": 600,
        "use": "正文栏宽：中文约 35 字/行、英文约 73 字符/行"
      },
      "measure-narrow": {
        "value": 480,
        "use": "图注、参数表说明"
      }
    },
    "section-fluid": {
      "section-s": "clamp(56px, 7vw, 96px)",
      "section-m": "clamp(72px, 9vw, 128px)",
      "section-l": "clamp(88px, 11vw, 160px)",
      "note": "窄屏替代值；min/max 仍是 8 的倍数"
    }
  },
  "type": {
    "family": {
      "stack": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", \"Noto Sans SC\", sans-serif",
      "note": "只用系统字体栈，不引外链字体；字体加载后重排会引发 CLS"
    },
    "scale": {
      "ratio-tool": 1.25,
      "ratio-editorial": 1.333,
      "base": 17
    },
    "size": {
      "h1": {
        "clamp": "clamp(40px, 4vw + 20.8px, 72px)",
        "at480": 40,
        "at1280": 72
      },
      "h2": {
        "clamp": "clamp(30px, 2.25vw + 19.2px, 48px)",
        "at480": 30,
        "at1280": 48
      },
      "h3": {
        "clamp": "clamp(23px, 0.875vw + 18.8px, 30px)",
        "at480": 23,
        "at1280": 30
      },
      "lead": {
        "clamp": "clamp(18px, 0.375vw + 16.2px, 21px)",
        "at480": 18,
        "at1280": 21
      },
      "body": {
        "clamp": "clamp(16px, 0.125vw + 15.4px, 17px)",
        "at480": 16,
        "at1280": 17
      },
      "small": {
        "value": 15,
        "note": "固定值；低于 15px 中文会掉笔画"
      },
      "caption": {
        "value": 13,
        "note": "仅用于图注与标签，不承载正文信息"
      }
    },
    "weight": {
      "h1": 600,
      "h2": 600,
      "h3": 600,
      "lead": 400,
      "body": 400,
      "small": 400,
      "caption": 400,
      "variable-range": [
        520,
        640
      ],
      "variable-note": "可变字重只在 520–640 之间过渡，不跨 400/700 台阶"
    },
    "tracking": {
      "h1": "-0.04em",
      "h2": "-0.03em",
      "h3": "-0.02em",
      "lead": "0",
      "body": "0",
      "small": "0",
      "caption": "0.01em"
    },
    "leading": {
      "h1": 1.08,
      "h2": 1.12,
      "h3": 1.2,
      "lead": 1.45,
      "body": 1.65,
      "small": 1.5,
      "caption": 1.4
    }
  },
  "color": {
    "neutral": {
      "n-0": "#FFFFFF",
      "n-1": "#F8F8F9",
      "n-2": "#EDEDEF",
      "n-3": "#C6C6CB",
      "n-4": "#9A9AA1",
      "n-5": "#73737B",
      "n-6": "#4C4C53",
      "n-7": "#31313A",
      "n-8": "#0A0A0C"
    },
    "contrast": {
      "on-white": {
        "n-3": 1.7,
        "n-4": 2.8,
        "n-5": 4.7,
        "n-6": 8.52,
        "n-7": 12.88,
        "n-8": 19.78
      },
      "on-n-8": {
        "n-0": 19.78,
        "n-1": 18.64,
        "n-2": 16.92,
        "n-3": 11.62,
        "n-4": 7.07,
        "n-5": 4.21,
        "n-6": 2.32
      }
    },
    "accent": {
      "accent": {
        "value": "#0A6CFF",
        "onWhite": 4.56,
        "onDark": 4.33,
        "use": "图形、按钮底、进度条；不做 17px 正文"
      },
      "accent-text": {
        "value": "#0055D4",
        "onWhite": 6.46,
        "use": "浅色模式文字链接"
      },
      "accent-text-dark": {
        "value": "#5EA8FF",
        "onDark": 8.03,
        "use": "深色模式文字链接"
      }
    },
    "dark": {
      "page": "#0A0A0C",
      "surface": "#111114",
      "body": "#C6C6CB",
      "muted": "#9A9AA1",
      "border": "#2A2A2F",
      "note": "深色不是反色：#73737B 在 #0A0A0C 上只有 4.21:1，不能当次要正文"
    }
  },
  "motion": {
    "duration": {
      "t-1": {
        "value": 120,
        "use": "hover、按下、颜色变化"
      },
      "t-2": {
        "value": 240,
        "use": "展开、淡入、位移 ≤ 24px"
      },
      "t-3": {
        "value": 400,
        "use": "面板滑入、整段替换"
      },
      "t-4": {
        "value": 650,
        "use": "首屏叙事、一次性揭示；上限"
      }
    },
    "easing": {
      "ease-out": {
        "value": "cubic-bezier(0.16, 1, 0.3, 1)",
        "use": "入场、展开"
      },
      "ease-in-out": {
        "value": "cubic-bezier(0.65, 0, 0.35, 1)",
        "use": "往返、切换"
      },
      "ease-in": {
        "value": "cubic-bezier(0.7, 0, 0.84, 0)",
        "use": "离场、收起"
      },
      "ease-standard": {
        "value": "cubic-bezier(0.2, 0, 0, 1)",
        "use": "位移、滑动"
      }
    },
    "distance": {
      "max": 24,
      "steps": [
        8,
        16,
        24
      ],
      "note": "入场位移超过 24px 会被读成加载失败"
    },
    "stagger": {
      "min": 60,
      "max": 90,
      "maxItems": 4
    },
    "exitRatio": 0.6
  },
  "scroll": {
    "reveal": {
      "threshold": 0.15,
      "rootMargin": "0px 0px -12% 0px",
      "onceOnly": true,
      "range": "entry 20% cover 45%",
      "note": "默认态必须是已显示，动画只做过渡"
    },
    "toc": {
      "rootMargin": "-45% 0px -45% 0px",
      "note": "视口中线所在的标题成为当前项"
    },
    "parallax": {
      "ratios": [
        0.15,
        0.25,
        0.4
      ],
      "default": 0.25,
      "max": 0.4
    },
    "stickyHeader": {
      "height": [
        56,
        64
      ],
      "max": 72
    },
    "scrollHijack": {
      "allowed": false,
      "note": "吃掉滚轮做钉住会破坏锚点与前进后退"
    }
  },
  "breakpoints": {
    "sm": {
      "value": 640,
      "trigger": "600px 栏宽 + 2×20px 边距，正文开始被压"
    },
    "md": {
      "value": 900,
      "trigger": "5fr/7fr 的文字块 < 420px，lead 断句难看"
    },
    "lg": {
      "value": 1200,
      "trigger": "1120 容器 + 边距 > 视口，出现横向滚动"
    }
  },
  "a11y": {
    "touch": {
      "min": 44,
      "primaryButton": 48,
      "icon": 20,
      "gap": 8
    },
    "contrast": {
      "body": 4.5,
      "large": 3,
      "focus": 3
    },
    "largeText": {
      "regular": 24,
      "bold": 19
    },
    "reducedMotion": {
      "duration": "0.01ms",
      "note": "不用 none，否则 animationend 不触发"
    }
  },
  "presets": {
    "product-launch": {
      "ratio": 1.333,
      "section": [
        "96px",
        "128px",
        "160px"
      ],
      "measure": 600,
      "accentUsage": "只用在主 CTA",
      "hero": "纯排版或分栏，二选一",
      "use": "产品发布页、硬件页"
    },
    "docs": {
      "ratio": 1.25,
      "section": [
        "64px",
        "96px"
      ],
      "measure": 600,
      "measureNarrow": 480,
      "accentUsage": "只在链接与选中态",
      "sidebar": [
        240,
        200
      ],
      "use": "文档站、规范站"
    },
    "brand": {
      "ratio": 1.333,
      "section": [
        "128px",
        "160px"
      ],
      "measure": 520,
      "accentUsage": "0 处或 1 处",
      "use": "品牌站、作品集"
    },
    "app-landing": {
      "ratio": 1.25,
      "section": [
        "64px",
        "96px",
        "128px"
      ],
      "measure": 560,
      "accentUsage": "CTA + 1 处数据高亮",
      "use": "应用落地页"
    }
  }
}