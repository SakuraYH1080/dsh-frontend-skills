{
  "$comment": "frontend-taste-base 的唯一数值真源。改这里就必须同步改 SKILL.md 第三节、references/10-sections.md、20-motion.md、40-type-cn.md 与 assets/taste-base.css。",
  "version": "1.0.0",
  "meta": {
    "name": "frontend-taste-base",
    "unit": "px 除注明外",
    "grid": 8
  },
  "grid": {
    "u": {
      "value": 8,
      "note": "所有间距必须是它的倍数。出现 37/55 这类值即退回。"
    },
    "gap": {
      "gap-1": {
        "value": 8,
        "use": "图标与文字、标签与值"
      },
      "gap-2": {
        "value": 16,
        "use": "段落内、列表项之间"
      },
      "gap-3": {
        "value": 24,
        "use": "标题与其正文之间（下限）"
      },
      "gap-4": {
        "value": 32,
        "use": "h2 与首个内容块之间（标准）"
      },
      "gap-5": {
        "value": 48,
        "use": "节内两个子组之间（上限，再大就该拆节）"
      }
    },
    "container": {
      "wrap": {
        "value": 1200,
        "use": "内容区最大宽度；出血图不受限"
      },
      "gut": {
        "value": 80,
        "use": "桌面左右留白（1440 视口下）；1220 以上固定 80"
      },
      "gut-md": {
        "value": 40,
        "use": "平板 640–1023 的左右留白"
      },
      "gut-sm": {
        "value": 24,
        "use": "手机 <640；低于 20 中文一行放不下 20 字"
      }
    },
    "pad": {
      "padt": {
        "value": 120,
        "use": "桌面每节顶部内距；决定内容窗口 708 的起点"
      },
      "padb": {
        "value": 72,
        "use": "桌面每节底部内距"
      },
      "padt-sm": {
        "value": 96,
        "use": "手机每节顶部内距"
      },
      "padb-sm": {
        "value": 48,
        "use": "手机每节底部内距"
      }
    }
  },
  "window": {
    "$note": "内容窗口 = 视口高 − padt − padb。判一个节该是 --h:1 还是 --h:2 就看内容高 c 落在哪一段。",
    "desktop": {
      "viewport": {
        "value": 900,
        "use": "1440×900 基准视口高"
      },
      "padt": {
        "value": 120
      },
      "padb": {
        "value": 72
      },
      "one": {
        "value": 708,
        "use": "一屏内容窗口 = 900 − 120 − 72"
      }
    },
    "thresholds": {
      "merge-below": {
        "value": 360,
        "use": "c < 360：太空，合并进上一节"
      },
      "thin-zone": {
        "value": 495,
        "use": "360 ≤ c < 495：一屏但需视觉锚点；低于此值一票退回"
      },
      "one-screen-max": {
        "value": 708,
        "use": "495 ≤ c ≤ 708：--h:1 合格"
      },
      "illegal-band": {
        "value": [
          708,
          1320
        ],
        "use": "非法带：必须砍 / 拆 / 两栏三选一。开区间，不含端点"
      },
      "two-screen-min": {
        "value": 1320,
        "use": "1320 ≤ c ≤ 1608：--h:2 合格"
      },
      "two-screen-max": {
        "value": 1608,
        "use": "c > 1608：拆成两节以上"
      }
    },
    "fill": {
      "min": {
        "value": 0.55,
        "use": "c / 节高 的下限。低于它读者会以为这屏没加载完"
      },
      "target": {
        "value": 0.75,
        "use": "理想值；写满到 1.0 也是好的，不设上限"
      }
    },
    "mobile": {
      "viewport": {
        "value": 844,
        "use": "390×844"
      },
      "one": {
        "value": [
          464,
          700
        ],
        "use": "手机一屏内容区；取保守下界 464 判"
      },
      "two": {
        "value": [
          1268,
          1544
        ],
        "use": "手机两屏内容区"
      }
    },
    "tablet": {
      "viewport": {
        "value": 1024,
        "use": "768×1024 与 820×1180 竖屏"
      },
      "one-max": {
        "value": 832,
        "use": "c ≤ 832 判一屏"
      },
      "two": {
        "value": [
          1130,
          1856
        ],
        "use": "两屏区间；1130 以下必须砍到一屏"
      }
    }
  },
  "sections": {
    "count": {
      "min": 5,
      "max": 6,
      "use": "不含 footer；少于 5 撑不起叙事，多于 6 读者失去地图"
    },
    "h": {
      "values": [
        1,
        2
      ],
      "default": 1,
      "use": "--h 只允许 1 或 2。出现 3 一票退回"
    },
    "one-h2": {
      "value": true,
      "use": "每节恰好一个 h2 且必须是首元素"
    },
    "cards": {
      "max": 6,
      "use": "background 与 border-radius 同时非默认的元素数上限"
    },
    "dividers": {
      "max": 1,
      "use": "一页最多一条品牌色收尾带；border-top 当分隔线为 0 条"
    }
  },
  "type": {
    "$note": "中文排版基准。英文页面把 measure 换成 62ch、body 可降到 15–16px、行高 1.5–1.8。",
    "size": {
      "body": {
        "value": 17,
        "use": "正文。中文下限 16，甜点值 17"
      },
      "body-sm": {
        "value": 15,
        "use": "次要正文；不再往下降"
      },
      "label": {
        "value": 13,
        "use": "标签 / 元信息。11px 中文不可读"
      },
      "h3": {
        "value": 21
      },
      "h2": {
        "value": 32
      },
      "h1": {
        "value": 52
      },
      "hero": {
        "value": 72,
        "use": "仅 hero 允许；一页最多一次"
      }
    },
    "lh": {
      "body": {
        "value": 1.8,
        "use": "17px 正文；中文 1.7 是下限"
      },
      "body-sm": {
        "value": 1.75
      },
      "h3": {
        "value": 1.6
      },
      "h2": {
        "value": 1.3
      },
      "h1": {
        "value": 1.2
      },
      "hero": {
        "value": 1.12
      },
      "label": {
        "value": 1.5
      }
    },
    "measure": {
      "cn": {
        "value": "34em",
        "use": "中文正文行宽 = 34 字，落在 28–40 中段"
      },
      "cn-min": {
        "value": 28,
        "use": "低于 28 字：断行太碎"
      },
      "cn-max": {
        "value": 40,
        "use": "高于 45 字：眼睛回头会跳行"
      },
      "en": {
        "value": "62ch",
        "use": "英文段落仍用 62ch；混排页面必须分两个类"
      },
      "note": {
        "value": 600,
        "use": "1200 容器下的等效像素值，仅供估高参考"
      }
    },
    "tracking": {
      "hero": {
        "value": "-0.02em",
        "use": "≥40px 中文大标题收紧"
      },
      "h1": {
        "value": "-0.01em"
      },
      "body": {
        "value": 0
      },
      "caps-en": {
        "value": "0.14em",
        "use": "仅全大写英文标签；中文标题禁止加字距"
      }
    },
    "weight": {
      "allowed": [
        300,
        400,
        500,
        700
      ],
      "body": {
        "value": 400,
        "use": "中文 300 在非 Retina 上发虚，禁止用于正文"
      },
      "ui-note": {
        "value": "600 与 700 在系统字体里常映射同一字形，不可同时使用"
      }
    },
    "scale": {
      "ratio-1.25": {
        "value": [
          14,
          17,
          21,
          26,
          33,
          41,
          52,
          65
        ],
        "use": "信息密集的产品页"
      },
      "ratio-1.333": {
        "value": [
          13,
          17,
          23,
          31,
          41,
          55,
          73
        ],
        "use": "少量大字的海报式页面"
      },
      "levels-used": {
        "value": 5,
        "use": "一页最多用 5 级；超过 5 级读者判断不出层级"
      }
    },
    "font": {
      "sans": {
        "value": "\"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", \"Source Han Sans SC\", \"Noto Sans CJK SC\", system-ui, sans-serif",
        "use": "顺序不可换；缺 Microsoft YaHei 会让 Windows 掉到宋体"
      },
      "serif": {
        "value": "\"Songti SC\", \"Source Han Serif SC\", \"Noto Serif CJK SC\", \"SimSun\", Georgia, serif"
      },
      "mono": {
        "value": "\"JetBrains Mono\", \"SF Mono\", Menlo, Consolas, \"Sarasa Mono SC\", monospace"
      },
      "webfont": {
        "value": false,
        "use": "正文禁止用 webfont 加载中文黑体（单字体 5–10MB）；仅标题可子集化使用"
      }
    },
    "cjk": {
      "italic": {
        "value": false,
        "use": "中文无真斜体；italic 是合成倾斜。改用字重 / 颜色 / 左竖线"
      },
      "punct": {
        "value": "fullwidth",
        "use": "，。、；：？！全角；括号内纯英文或数字可用半角"
      },
      "line-break": {
        "value": "strict",
        "use": "原生避头尾，唯一可靠方案；不要脚本插 wbr"
      },
      "space-mix": {
        "value": "0.25em",
        "use": "中英混排间隙；用 text-autospace 而非手敲空格"
      },
      "linehead-ban": {
        "value": [
          "，",
          "。",
          "、",
          "；",
          "：",
          "？",
          "！",
          "）",
          "」",
          "』",
          "】",
          "》",
          "…"
        ],
        "use": "行首禁止出现"
      }
    }
  },
  "motion": {
    "layers": {
      "hero": {
        "value": 1,
        "use": "每页 1 次，只在 hero；总时长 ≤ 1.6s（含错开）"
      },
      "moment": {
        "value": 1,
        "use": "dealt moment：每页恰好 1 次。第二个出现时第一个就不再特殊"
      },
      "hover": {
        "value": "unlimited",
        "use": "同一类元素必须一致，120–240ms"
      }
    },
    "duration": {
      "micro": {
        "value": 120,
        "use": "hover 颜色 / 透明度 / ≤4px 位移"
      },
      "small": {
        "value": 240,
        "use": "按下、卡片抬起、下拉展开"
      },
      "mid": {
        "value": 400,
        "use": "面板进出、内容替换、moment 短版"
      },
      "large": {
        "value": 650,
        "use": "整屏转场、hero 内部收尾"
      },
      "heroTotal": {
        "value": 1100,
        "use": "hero 入场标称总时长；1200 是硬上限"
      },
      "heroMax": {
        "value": 1600,
        "use": "从可交互到最后一个 hero 元素落位；超过读者会怀疑卡了"
      }
    },
    "easing": {
      "out-quart": {
        "value": "cubic-bezier(0.25, 1, 0.5, 1)",
        "use": "入场：快速起，长尾停"
      },
      "out-expo": {
        "value": "cubic-bezier(0.16, 1, 0.3, 1)",
        "use": "大位移、整块进入"
      },
      "in-out-quad": {
        "value": "cubic-bezier(0.45, 0, 0.55, 1)",
        "use": "状态切换、颜色、透明度"
      },
      "overshoot": {
        "value": false,
        "use": "控制点 y 必须都在 [0,1]。带回弹 = 模板感的最强标记"
      }
    },
    "stagger": {
      "n-3": {
        "value": 120,
        "use": "≤3 个元素"
      },
      "n-6": {
        "value": 90,
        "use": "4–6 个元素"
      },
      "n-more": {
        "value": 0,
        "use": ">6 个元素不要错开，整块一起入（650ms）；错开 8 个最后一个要等 720ms"
      }
    },
    "props": {
      "allowed": {
        "value": [
          "transform",
          "opacity"
        ],
        "use": "只走合成线程，不触发 layout / paint"
      },
      "exception": {
        "value": "clip-path",
        "use": "仅 dealt moment 揭示，且元素需独立合成层"
      },
      "forbidden": {
        "value": [
          "width",
          "height",
          "top",
          "left",
          "margin",
          "background-color",
          "box-shadow",
          "filter"
        ],
        "use": "触发 layout 或 paint"
      }
    },
    "budget": {
      "frame": {
        "value": 16.7,
        "use": "60Hz 单帧预算"
      },
      "anim": {
        "value": 6,
        "use": "动画可占部分，≤6ms"
      },
      "concurrent": {
        "value": 8,
        "use": "同屏同时运动元素上限"
      },
      "total": {
        "value": 20,
        "use": "全页动画元素总数上限（含 hover 层）"
      },
      "blurArea": {
        "value": 0.4,
        "use": "backdrop-filter / filter 面积 ≤ 视口 40%"
      }
    },
    "reduced": {
      "query": {
        "value": "prefers-reduced-motion: reduce",
        "use": "降级为静态终态，不是关掉"
      },
      "duration": {
        "value": "1ms",
        "use": "不用 none，否则 animationend 不触发"
      },
      "require": {
        "value": "static-final-state",
        "use": "所有 moment 必须有静态终态；终态是空白 = 设计错误"
      }
    },
    "momentDeck": {
      "active": {
        "value": [
          "sticky-pin",
          "clip-reveal",
          "number-count",
          "image-swap",
          "type-mask",
          "section-shift",
          "line-draw",
          "grid-morph",
          "scroll-zoom",
          "text-scramble",
          "cursor-trail",
          "liquid-hover",
          "vhs-glitch"
        ],
        "use": "在役 13 张，按实现成本排序见 references/20-motion.md"
      },
      "retired": {
        "value": [
          "closing-lift",
          "headline-arrives",
          "lines-rise",
          "window-parallax",
          "word-rotate"
        ],
        "use": "退役 5 张，彼此太像或模板感最强，不要用"
      }
    }
  },
