{
  "$comment": "frontend-anime-fusion 的唯一数值权威。SKILL.md 表格、anime.css、templates 均以此为准；三处冲突时改那两处。",
  "name": "frontend-anime-fusion",
  "version": "1.0.0",
  "unit": {
    "length": "px",
    "charHeight": "% of viewport height",
    "headroom": "% of character height",
    "anchor": "% of viewport width",
    "scrim": "0-1 alpha",
    "parallax": "ratio of page scroll"
  },
  "knobs": {
    "charH": {
      "cssVar": "--af-char-h",
      "default": 62,
      "min": 45,
      "max": 80,
      "unitless": true,
      "note": "% of viewport height, unitless for calc()"
    },
    "headroom": {
      "cssVar": "--af-headroom",
      "default": 10,
      "min": 5,
      "max": 16
    },
    "anchorX": {
      "cssVar": "--af-anchor-x",
      "default": 61.8,
      "min": 25,
      "max": 75
    },
    "gaze": {
      "cssVar": "--af-gaze",
      "default": "right",
      "values": [
        "left",
        "right",
        "front"
      ]
    },
    "scrim": {
      "cssVar": "--af-scrim",
      "default": 0.72,
      "min": 0.4,
      "max": 0.88
    },
    "panelGap": {
      "cssVar": "--af-panel-gap",
      "default": 24,
      "min": 16,
      "max": 40
    },
    "edgeGlow": {
      "cssVar": "--af-edge-glow",
      "default": 60,
      "min": 0,
      "max": 100
    },
    "parallax": {
      "cssVar": "--af-parallax",
      "default": 0.45,
      "min": 0,
      "max": 0.9
    },
    "breath": {
      "cssVar": "--af-breath-amp",
      "default": "2px",
      "durationVar": "--af-breath-dur",
      "duration": "4s",
      "ampMin": "1px",
      "ampMax": "3px"
    }
  },
  "forbiddenZone": {
    "widthRatio": 0.62,
    "heightRatio": 0.26,
    "topEdge": "headroom",
    "emotionalOverlapMax": 0.08,
    "note": "头部矩形；面板与其交集面积必须为 0，情绪性遮挡只允许压禁区下 1/3 且面积 <= 8%"
  },
  "layers": [
    {
      "id": "L0",
      "name": "背景环境",
      "z": 0
    },
    {
      "id": "L1",
      "name": "角色",
      "z": 10
    },
    {
      "id": "L2",
      "name": "界面面板",
      "z": 20
    },
    {
      "id": "L3",
      "name": "前景氛围",
      "z": 30
    }
  ],
  "motion": {
    "enterCharMs": 620,
    "enterPanelMs": 460,
    "enterPanelDelayMs": 140,
    "enterBackdropMs": 480,
    "enterAmbienceMs": 700,
    "enterAmbienceDelayMs": 320,
    "easeEnter": "cubic-bezier(.22,.61,.36,1)",
    "easeExit": "cubic-bezier(.4,0,1,1)",
    "gazeEnterMs": 320,
    "gazeExitMs": 240,
    "expressionMs": 180,
    "breathAmp": "2px",
    "breathDur": "4s"
  },
  "contrast": {
    "bodyMin": 4.5,
    "largeTextMin": 3,
    "uiComponentMin": 3,
    "scrimFormula": "alpha >= 1 - 0.1833 / L_bg (white text over black scrim)"
  },
  "palette": {
    "paper": "#FFF7FA",
    "ink": "#10121A",
    "accent": "#FF5C8A",
    "accent2": "#7BD7F5",
    "gold": "#F5C86B",
    "rim": "#FFD9E4",
    "shadow": "rgba(16,18,26,.35)"
  },
  "typography": {
    "stack": "system-ui, -apple-system, \"Segoe UI\", \"Noto Sans SC\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", sans-serif",
    "displayStack": "\"Iowan Old Style\", \"Songti SC\", Georgia, serif",
    "bodyLineHeight": 1.65,
    "measureCh": 34
  },
  "presets": {
    "stage": {
      "model": "A",
      "charH": 68,
      "headroom": 10,
      "anchorX": 61.8,
      "scrim": 0.72,
      "panelGap": 24,
      "edgeGlow": 60,
      "parallax": 0.45,
      "cut": null,
      "gaze": "right",
      "scene": "角色展示页、图鉴详情"
    },
    "launcher": {
      "model": "B",
      "charH": 74,
      "headroom": 8,
      "anchorX": 66.7,
      "scrim": 0.78,
      "panelGap": 24,
      "edgeGlow": 70,
      "parallax": 0.85,
      "cut": "46%",
      "gaze": "right",
      "scene": "游戏启动器、抽卡"
    },
    "profile": {
      "model": "C",
      "charH": 48,
      "headroom": 12,
      "anchorX": 50,
      "scrim": 0,
      "panelGap": 32,
      "edgeGlow": 40,
      "parallax": 0,
      "cut": null,
      "gaze": "front",
      "scene": "个人主页、团队介绍"
    },
    "campaign": {
      "model": "B",
      "charH": 62,
      "headroom": 12,
      "anchorX": 61.8,
      "scrim": 0.82,
      "panelGap": 28,
      "edgeGlow": 55,
      "parallax": 0.75,
      "cut": "52%",
      "gaze": "left",
      "scene": "活动落地页、版本宣传"
    }
  },
  "responsive": {
    "breakpoints": {
      "sm": 640,
      "md": 900,
      "lg": 1280,
      "xl": 1920
    },
    "objectPosition": {
      "360": "50% 4%",
      "768": "50% 0%",
      "1280": "50% 0%",
      "1920": "50% 0%"
    },
    "portrait": {
      "charH": 52,
      "headroom": 12,
      "anchorX": 50,
      "parallax": 0,
      "panelOverlap": 24
    },
    "landscape": {
      "maxHeight": 500,
      "charH": 46,
      "headroom": 6,
      "hideAmbience": true
    }
  },
  "copyright": {
    "sourceTypes": [
      "official",
      "fanart",
      "commissioned",
      "ai-generated",
      "original"
    ],
    "allowedFlags": [
      "web-display",
      "commercial",
      "modify",
      "redistribute"
    ],
    "mainVisualMinCharH": 55,
    "aiMaxCharH": 40
  }
}
