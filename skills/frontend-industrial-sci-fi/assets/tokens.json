{
  "name": "frontend-industrial-sci-fi",
  "version": "1.0.0",
  "unit": "px",
  "channels": {
    "accent": "唯一强调通道：表示当前位置 / 可点击。只填充，不描边。",
    "state": "语义通道：表示正常 / 警告 / 中断。不出现在按钮、选中态、链接上。"
  },
  "base": {
    "ink": {
      "300": "#8B979F",
      "500": "#828E96",
      "700": "#1C2126",
      "850": "#111417",
      "900": "#0A0C0E",
      "950": "#07090A"
    },
    "paper": {
      "100": "#E3E7E5",
      "000": "#F2F4F3"
    },
    "line": {
      "strong": "#66737B",
      "weak": "#262C31",
      "onLight": "#CBD2CF"
    }
  },
  "accent": {
    "signal": "#C8F04B",
    "signalHover": "#BCE146",
    "signalNight": "#A6C43E",
    "signalHoverNight": "#98B536",
    "signalOnLight": "#5A6D1E",
    "signalHoverOnLight": "#4C5D19",
    "rule": "hover 用显式色值，不用 filter 压暗——滤镜作用在渲染后像素上，对比度全部失效"
  },
  "state": {
    "nominal": "#8B979F",
    "caution": "#E8A33D",
    "interrupt": "#E2453C",
    "cautionOnLight": "#8F5A10",
    "nominalOnLight": "#6E7A82",
    "interruptOnLight": "#B22E26",
    "rule": "只升不降；降级需要显式 RESET / ACK"
  },
  "type": {
    "scale": {
      "display": {
        "px": 40,
        "line": 1.1,
        "weight": 700,
        "track": "-0.01em"
      },
      "readout": {
        "px": 20,
        "line": 1.2,
        "weight": 700,
        "track": "0"
      },
      "body": {
        "px": 13,
        "line": 1.45,
        "weight": 400,
        "track": "0"
      },
      "label": {
        "px": 11,
        "line": 1.2,
        "weight": 500,
        "track": "0.14em"
      },
      "micro": {
        "px": 10,
        "line": 1.2,
        "weight": 500,
        "track": "0.18em"
      }
    },
    "track": {
      "tight": "0.10em",
      "base": "0.14em",
      "wide": "0.18em"
    },
    "stretch": {
      "declared": "125%",
      "fallback": "scaleX(1.06)"
    },
    "stack": {
      "label": "\"Helvetica Neue\", Arial, \"PingFang SC\", sans-serif",
      "readout": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace",
      "body": "-apple-system, \"PingFang SC\", \"Microsoft YaHei\", sans-serif"
    }
  },
  "geometry": {
    "radius": 0,
    "corners": [
      "top-right",
      "bottom-left"
    ],
    "cut": {
      "chip": 4,
      "card": 8,
      "panel": 14
    },
    "cutInnerFormula": "cut - 1.414",
    "hairline": 1
  },
  "space": {
    "s-1": 4,
    "s-2": 8,
    "s-3": 12,
    "s-4": 16,
    "s-6": 24,
    "s-12": 48,
    "s-16": 64,
    "rhythm": "1:6:12"
  },
  "motion": {
    "instant": 0,
    "tick": 90,
    "geom": 140,
    "enter": 220,
    "ease": "cubic-bezier(0.2,0,0,1)",
    "interruptHz": 1,
    "interruptEasing": "steps(2, end)",
    "rule": "颜色 0ms；几何 90–140ms；进场 ≤220ms；同屏并行动效 ≤3"
  },
  "presets": {
    "standard": {
      "page": "#0A0C0E",
      "panel": "#111417",
      "raised": "#1C2126",
      "text": "#F2F4F3",
      "textSecondary": "#8B979F",
      "textMuted": "#828E96",
      "line": "#66737B",
      "lineWeak": "#262C31",
      "signal": "#C8F04B",
      "signalHover": "#BCE146",
      "onSignal": "#0A0C0E",
      "row": 32,
      "cutCard": 8,
      "pad": 16,
      "modules": 12,
      "readoutPx": 20,
      "dur": 140
    },
    "cold-store": {
      "page": "#F2F4F3",
      "panel": "#E3E7E5",
      "raised": "#D6DCD9",
      "text": "#0A0C0E",
      "textSecondary": "#4A545C",
      "textMuted": "#56626A",
      "line": "#717C83",
      "lineWeak": "#CBD2CF",
      "signal": "#5A6D1E",
      "signalHover": "#4C5D19",
      "onSignal": "#F2F4F3",
      "row": 36,
      "cutCard": 8,
      "pad": 20,
      "modules": 10,
      "readoutPx": 20,
      "dur": 160,
      "stateOverride": {
        "nominal": "#6E7A82",
        "caution": "#8F5A10",
        "interrupt": "#B22E26"
      }
    },
    "site": {
      "page": "#07090A",
      "panel": "#111417",
      "raised": "#1C2126",
      "text": "#F2F4F3",
      "textSecondary": "#8B979F",
      "textMuted": "#828E96",
      "line": "#66737B",
      "lineWeak": "#262C31",
      "signal": "#C8F04B",
      "signalHover": "#BCE146",
      "onSignal": "#0A0C0E",
      "row": 40,
      "cutCard": 4,
      "pad": 16,
      "modules": 6,
      "readoutPx": 40,
      "dur": 140,
      "minTap": 40
    },
    "night-shift": {
      "page": "#07090A",
      "panel": "#0A0C0E",
      "raised": "#111417",
      "text": "#E3E7E5",
      "textSecondary": "#8B979F",
      "textMuted": "#828E96",
      "line": "#66737B",
      "lineWeak": "#1C2126",
      "signal": "#A6C43E",
      "signalHover": "#98B536",
      "onSignal": "#0A0C0E",
      "row": 32,
      "cutCard": 8,
      "pad": 16,
      "modules": 8,
      "readoutPx": 20,
      "dur": 90,
      "interruptStatic": true
    }
  },
  "variantCard": [
    "preset: <standard|cold-store|site|night-shift>",
    "density: <row>px row / <n> modules per screen / padding <pad>px",
    "dominant: <industry|research>"
  ]
}
